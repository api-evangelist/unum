  "info": {
    "_postman_id": "3d0f62eb-ada6-41b0-bfde-0ceda5a5280b",
    "name": "Unum HR Connect Authentication Evidence of Insurability API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Unum HR Connect API provides a secure, real-time connection between Unum benefits and major HR platforms including Workday, ADP, and UKG. It automates eligibility checks, evidence of insurability (EOI) processing, premium billing calculations, leave and absence management, and enrollment data synchronization for employers and HR technology partners.\n\nContact Support:\n Name: Unum Developer Support",
      "type": "text/plain"
    }
  }
